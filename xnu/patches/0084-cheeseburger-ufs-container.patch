  * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
  * against the partition bounds again right before it is issued, so nothing
  * outside the named partition can be written.
+ *
+ * Container mode (cheeseburger, keeps Android): if /sweet-ufs has
+ * "container-extents", ufsroot0 is not the whole partition but one file in
+ * Android's ext4 userdata (/data/ios/root.img). The property is a list of
+ * u64 triples in 4 KiB device blocks: (file block, partition block, count),
+ * sorted by file block and gap-free from 0 (tools/mkadt.py --container).
+ * Every I/O goes through that map, and every write must also lie inside one
+ * extent, so Android's files outside the container cannot be written.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -105,6 +113,9 @@ static struct {
 	uint8_t lun;
 	uint8_t tag;
 	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint64_t disk_blocks;                   /* size of ufsroot0: partition or container */
+	const uint64_t *ext;                    /* container extents (device tree), or NULL */
+	uint32_t next;                          /* number of extent triples */
 	uint32_t secsize;                       /* logical sector size for the BSD layer */
 	bool writable;                          /* boot-arg ufsrw=1 */
 	bool cache;                             /* boot-arg ufscache=1 */
@@ -271,6 +282,44 @@ ufs_read_blocks(uint64_t lba, uint32_t count)
 	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
 }
 
+/* Container mode: is [pblk, pblk + count) (partition blocks) inside one extent? */
+static bool
+ufs_in_container(uint64_t pblk, uint32_t count)
+{
+	if (su.ext == NULL) {
+		return true;
+	}
+	for (uint32_t i = 0; i < su.next; i++) {
+		const uint64_t *e = &su.ext[3 * i];
+		if (pblk >= e[1] && pblk - e[1] < e[2] && count <= e[2] - (pblk - e[1])) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * ufsroot0 block -> absolute device block. *run = how many of want blocks
+ * are contiguous on the device from there (at least 1).
+ */
+static uint64_t
+ufs_map(uint64_t lblk, uint32_t want, uint32_t *run)
+{
+	*run = want;
+	if (su.ext == NULL) {
+		return su.first_block + lblk;
+	}
+	for (uint32_t i = 0; i < su.next; i++) {
+		const uint64_t *e = &su.ext[3 * i];
+		if (lblk >= e[0] && lblk - e[0] < e[2]) {
+			uint64_t left = e[2] - (lblk - e[0]);
+			*run = (uint32_t)MIN((uint64_t)want, left);
+			return su.first_block + e[1] + (lblk - e[0]);
+		}
+	}
+	panic("SWEET UFS: container block 0x%llx unmapped", lblk);
+}
