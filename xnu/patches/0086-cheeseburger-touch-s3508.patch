@@ -0,0 +1,298 @@
+/*
+ * RPM requests for cheeseburger (OnePlus 5, MSM8998): GLINK on the RPM edge
+ * and the "rpm_requests" channel (SMD RPM protocol), as mainline Linux does
+ * it in drivers/rpmsg/qcom_glink_{rpm,native}.c, soc/qcom/smd-rpm.c and
+ * regulator/qcom_smd-regulator.c. Polled, no interrupt; one caller at a
+ * time (sweet_rpm_lock). Measured with the shim probe (NOTES.md): TOC n=12,
+ * r2ap at 0x900, ap2r at 0x200, 0x6f8 bytes each, RPM answers "msg#".
+ *
+ * Writes: our ends of the two message RAM FIFOs and the APCS IPC doorbell.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpm_ldo(uint32_t ldo, uint32_t uv, uint32_t ma);
+
+#define RPM_MSGRAM_PA   0x00778000u    /* qcom,rpm-msg-ram */
+#define RPM_MSGRAM_SZ   0x7000u
+#define RPM_APCS_PA     0x17911000u    /* apcs-hmss-global; IPC at +8, bit 0 = RPM */
+#define RPM_TOC_MAGIC   0x67727430u    /* "grt0" */
+#define RPM_RX_ID       0x72326170u    /* r2ap */
+#define RPM_TX_ID       0x61703272u    /* ap2r */
+
+#define GLINK_VERSION       0
+#define GLINK_VERSION_ACK   1
+#define GLINK_OPEN          2
+#define GLINK_CLOSE         3
+#define GLINK_OPEN_ACK      4
+#define GLINK_INTENT        5
+#define GLINK_TX_DATA       9
+#define GLINK_CLOSE_ACK     11
+#define GLINK_TX_DATA_CONT  12
+#define GLINK_LCID          1
+
+struct rpm_pipe {
+	vm_offset_t tail, head, fifo;
+	uint32_t len;
+};
+
+static LCK_GRP_DECLARE(sweet_rpm_grp, "sweet_rpm");
+static LCK_MTX_DECLARE(sweet_rpm_lock, &sweet_rpm_grp);
+static vm_offset_t rpm_ram, rpm_apcs;
+static struct rpm_pipe rpm_rx, rpm_tx;
+static bool rpm_up, rpm_failed;
+static uint32_t rpm_vack, rpm_open_ack, rpm_ropen, rpm_msg_id = 1;
+static uint8_t rpm_data[64];
+static uint32_t rpm_data_len;
+
+static uint32_t
+rpm_rd(vm_offset_t a)
+{
+	uint32_t v = *(volatile uint32_t *)a;
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rpm_wr(vm_offset_t a, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)a = v;
+}
+
+static uint32_t
+rpm_wrap(uint32_t v, uint32_t len)
+{
+	return v >= len ? v - len : v;
+}
+
+static bool
+rpm_toc(void)
+{
+	vm_offset_t toc = rpm_ram + RPM_MSGRAM_SZ - 256;
+	if (rpm_rd(toc) != RPM_TOC_MAGIC) {
+		printf("SWEET RPM: bad TOC magic %#x\n", rpm_rd(toc));
+		return false;
+	}
+	uint32_t n = rpm_rd(toc + 4);
+	for (uint32_t i = 0; i < n && i < 20; ++i) {
+		uint32_t id = rpm_rd(toc + 8 + 12 * i), off = rpm_rd(toc + 12 + 12 * i);
+		uint32_t sz = rpm_rd(toc + 16 + 12 * i);
+		struct rpm_pipe *p = id == RPM_RX_ID ? &rpm_rx : id == RPM_TX_ID ? &rpm_tx : NULL;
+		if (!p || off + sz > RPM_MSGRAM_SZ) {
+			continue;
+		}
+		p->tail = rpm_ram + off;
+		p->head = rpm_ram + off + 4;
+		p->fifo = rpm_ram + off + 8;
+		p->len = sz;
+	}
+	printf("SWEET RPM: TOC n=%u rx=%#lx/%#x tx=%#lx/%#x\n", n,
+	    (unsigned long)(rpm_rx.tail - rpm_ram), rpm_rx.len,
+	    (unsigned long)(rpm_tx.tail - rpm_ram), rpm_tx.len);
+	return rpm_rx.len && rpm_tx.len;
+}
+
+/* nwords 32-bit words (a multiple of 2: GLINK pads to 8 bytes), then the doorbell. */
+static bool
+rpm_send(const uint32_t *w, unsigned nwords)
+{
+	uint32_t head = rpm_rd(rpm_tx.head), tail = rpm_rd(rpm_tx.tail);
+	uint32_t avail = tail <= head ? rpm_tx.len - head + tail : tail - head;
+	if (head >= rpm_tx.len || avail <= nwords * 4) {
+		return false;
+	}
+	for (unsigned i = 0; i < nwords; ++i) {
+		rpm_wr(rpm_tx.fifo + head, w[i]);
+		head = rpm_wrap(head + 4, rpm_tx.len);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	rpm_wr(rpm_tx.head, head);
+	__asm__ volatile("dsb sy" ::: "memory");
+	rpm_wr(rpm_apcs + 8, 1);
+	return true;
+}
+
+static void
+rpm_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint32_t w[2] = { cmd | (uint32_t)p1 << 16, p2 };
+	(void)rpm_send(w, 2);
+}
+
+static uint32_t
+rpm_rx_avail(void)
+{
+	uint32_t head = rpm_rd(rpm_rx.head), tail = rpm_rd(rpm_rx.tail);
+	if (head >= rpm_rx.len || tail >= rpm_rx.len) {
+		return 0;
+	}
+	return head < tail ? rpm_rx.len - tail + head : head - tail;
+}
+
+static uint32_t
+rpm_rx_word(uint32_t off)
+{
+	return rpm_rd(rpm_rx.fifo + rpm_wrap(rpm_rd(rpm_rx.tail) + off, rpm_rx.len));
+}
+
+/* Consume everything the RPM sent; false on a command we do not know. */
+static bool
+rpm_poll(void)
+{
+	while (rpm_rx_avail() >= 8) {
+		uint32_t w0 = rpm_rx_word(0), p2 = rpm_rx_word(4);
+		uint32_t cmd = w0 & 0xffffu, p1 = w0 >> 16, len = 8;
+		switch (cmd) {
+		case GLINK_VERSION:
+			rpm_cmd(GLINK_VERSION_ACK, 1, 0);
+			break;
+		case GLINK_VERSION_ACK:
+			rpm_vack = 1;
+			break;
+		case GLINK_OPEN:
+			rpm_ropen = 1;
+			len = 8 + (p2 & 0xffffu);
+			rpm_cmd(GLINK_OPEN_ACK, (uint16_t)p1, 0);
+			break;
+		case GLINK_OPEN_ACK:
+			rpm_open_ack = 1;
+			break;
+		case GLINK_INTENT:
+			len = 8 + 8 * p2;
+			break;
+		case GLINK_TX_DATA:
+		case GLINK_TX_DATA_CONT: {
+			uint32_t chunk = rpm_rx_word(8);
+			if (chunk > 1024) {
+				return false;
+			}
+			for (uint32_t i = 0; i < chunk && i < sizeof(rpm_data); i += 4) {
+				uint32_t v = rpm_rx_word(16 + i);
+				for (uint32_t k = 0; k < 4 && i + k < sizeof(rpm_data); ++k) {
+					rpm_data[i + k] = (uint8_t)(v >> (8 * k));
+				}
+			}
+			rpm_data_len = chunk;
+			len = 16 + chunk;
+			break;
+		}
+		case GLINK_CLOSE:
+			rpm_cmd(GLINK_CLOSE_ACK, (uint16_t)p1, 0);
+			break;
+		case 6: case 7: case 8: case GLINK_CLOSE_ACK: case 13: case 14: case 15:
+			break;
+		default:
+			printf("SWEET RPM: unknown GLINK command %u\n", cmd);
+			return false;
+		}
+		rpm_wr(rpm_rx.tail, rpm_wrap(rpm_rd(rpm_rx.tail) + ((len + 7) & ~7u), rpm_rx.len));
+	}
+	return true;
+}
+
+static bool
+rpm_wait(uint32_t *flag, unsigned ms)
+{
+	for (unsigned i = 0; i < ms * 10; ++i) {
+		if (!rpm_poll()) {
+			return false;
+		}
+		if (*flag) {
+			return true;
+		}
+		delay(100);
+	}
+	return false;
+}
+
+static bool
+rpm_start(void)
+{
+	rpm_ram = ml_io_map(RPM_MSGRAM_PA, RPM_MSGRAM_SZ);
+	rpm_apcs = ml_io_map(RPM_APCS_PA, 0x1000);
+	if (!rpm_ram || !rpm_apcs || !rpm_toc()) {
+		return false;
+	}
+	/* As glink_rpm_probe: reset our ends of both pipes, then negotiate. */
+	rpm_wr(rpm_tx.head, 0);
+	rpm_wr(rpm_rx.tail, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	rpm_cmd(GLINK_VERSION, 1, 0);
+	if (!rpm_wait(&rpm_vack, 1000)) {
+		printf("SWEET RPM: no VERSION_ACK\n");
+		return false;
+	}
+	(void)rpm_wait(&rpm_ropen, 300);
+	static const char name[] = "rpm_requests";
+	uint32_t w[6] = { GLINK_OPEN | GLINK_LCID << 16, sizeof(name), 0, 0, 0, 0 };
+	for (unsigned i = 0; i < sizeof(name); ++i) {
+		w[2 + i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+	}
+	(void)rpm_send(w, 6);
+	if (!rpm_wait(&rpm_open_ack, 1000)) {
+		printf("SWEET RPM: no OPEN_ACK\n");
+		return false;
+	}
+	if (!rpm_ropen) {
+		(void)rpm_wait(&rpm_ropen, 500);
+	}
+	printf("SWEET RPM: rpm_requests open (remote open %u)\n", rpm_ropen);
+	return true;
+}
+
+/*
+ * qcom_rpm_smd_write of one LDO-A resource in the active set: swen=1, uv,
+ * ma. The load matters: without it the LDO stays in low-power mode and the
+ * touch IC browns out once it starts scanning (touch probe 2).
+ */
+int
+sweet_rpm_ldo(uint32_t ldo, uint32_t uv, uint32_t ma)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_rpm_lock);
+	if (!rpm_up && !rpm_failed) {
+		rpm_up = rpm_start();
+		rpm_failed = !rpm_up;
+	}
+	if (!rpm_up) {
+		err = ENXIO;
+		goto out;
+	}
+	uint32_t w[20] = {
+		GLINK_TX_DATA | GLINK_LCID << 16, 0, 64, 0,     /* iid 0 (intentless), chunk, left */
+		0x00716572u, 20 + 36,                           /* "req", length */
+		rpm_msg_id++, 0, 0x616f646cu, ldo, 36,          /* id, active set, "ldoa", ldo, len */
+		0x6e657773u, 4, 1,                              /* swen */
+		0x00007675u, 4, uv,                             /* uv */
+		0x0000616du, 4, ma,                             /* ma */
+	};
+	rpm_data_len = 0;
+	if (!rpm_send(w, 20)) {
+		err = EBUSY;
+		goto out;
+	}
+	for (unsigned i = 0; i < 10000 && !rpm_data_len; ++i) {
+		if (!rpm_poll()) {
+			err = EIO;
+			goto out;
+		}
+		delay(100);
+	}
+	uint32_t type = rpm_data_len >= 12 ? (uint32_t)rpm_data[8] | rpm_data[9] << 8 |
+	    rpm_data[10] << 16 | (uint32_t)rpm_data[11] << 24 : 0;
+	if (type != 0x2367736du) {      /* "msg#"; "err" carries a text */
+		err = rpm_data_len ? EINVAL : ETIMEDOUT;
+	}
+	printf("SWEET RPM: ldoa%u %u uV %u mA -> %s (%#x)\n", ldo, uv, ma, err ? "failed" : "ok", type);
+out:
+	lck_mtx_unlock(&sweet_rpm_lock);
+	return err;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
