+/* Capacitive keys: right = Home (held as long as the key), left = Back. */
+static void
+touch_keys(uint8_t keys)
+{
+	uint8_t home = st.key_swap ? 2u : 1u, back = st.key_swap ? 1u : 2u;
+	uint8_t changed = keys ^ st.keys;
+	if (changed) {
+		printf("SWEET TOUCH: keys %#x\n", keys);
+	}
+	if (changed & home) {
+		sweet_hid_key(3, (keys & home) != 0);
+	}
+	if ((changed & back) && (keys & back)) {
+		st.back_pending = true;
+	}
+	st.keys = keys;
+}
+
+/*
+ * Back: a finger the panel never uses (id 9) swipes in from the left edge,
+ * 2 px to 840 px in about 130 ms at mid height. SweetHID marks a touch that
+ * starts within 48 px of an edge as an edge touch, which UIKit's
+ * interactive pop gesture (and Safari's back swipe) look for.
+ */
+static void
+touch_back_swipe(void)
+{
+	const int id = 9, y = TOUCH_H / 2;
+	sweet_hid_touch(id, 1, 2, y);
+	for (int i = 1; i <= 12; ++i) {
+		touch_wait(11);
+		sweet_hid_touch(id, 1, 2 + 70 * i, y);
+	}
+	touch_wait(11);
+	sweet_hid_touch(id, 0, 842, y);
+}
