+/* The observer channel page of one APID, mapped on first use. */
+static vm_offset_t
+keys_obs_map(uint16_t apid)
 {
 	if (apid == KEYS_NO_APID) {
+		return 0;
+	}
+	return ml_io_map(KEYS_OBS_PA + KEYS_OBS_STRIDE * apid, 0x1000);
