 /*
- * Minimal polled SWEET keys. Call once after the scheduler is running.
- * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
+ * Minimal polled keys, cheeseburger (OnePlus 5, MSM8998 + PM8998).
+ * Call once after the scheduler is running.
+ *
+ * PM8998 sits behind SPMI PMIC arbiter v3 (spmi@800f000): APID map at
+ * core + 0x800 + 4n (PPID in bits 19:8), owners at cnfg + 0x700 + 4n, one
+ * 0x8000 observer channel per APID (EE 0). Keys, as measured with the
+ * shim probe: power = PON (PPID 0x008) INT_RT_STS 0x810 bit 0; volume
+ * down = PM8998 GPIO5 (PPID 0x0c4), volume up = GPIO6 (PPID 0x0c5), both
+ * STATUS1 bit 0, active low. Both volume keys together are the iPhone 8
+ * Home button (HID consumer Menu).
  * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
  * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
  */
@@ -17,15 +25,22 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
