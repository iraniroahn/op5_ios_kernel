+/*
+ * MDP (msm8998 DPU 3.0): VIG0 at +0x4000 (SRC_SIZE 0x00, OUT_SIZE 0x0c),
+ * its QSEED3 at +0xa00, CTL0 FLUSH at +0x1018 (bit 0 = VIG0). ABL scans the
+ * splash out of VIG0 at 1080x1920 with PINGPONG0 autorefresh, so a smaller
+ * SRC_SIZE plus the scaler (as mainline dpu_hw_setup_scaler3: phase step
+ * src << 21 / dst, preload 4/3, filter 3 = bilinear, alpha bilinear) and a
+ * flush is all it takes. Done at the first frame, when the console is muted.
+ */
+static void
+mdp_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static uint32_t
+mdp_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+bool
+AppleCLCD::hwScaleEnable(void)
+{
+	const uint32_t vig = 0x4000, qs = vig + 0xa00;
+	uint32_t sw = fLogicalW, sh = fLogicalH, dw = fWidth, dh = fHeight;
+	if (fMdp == 0) {
+		fMdp = ml_io_map(0x0c901000, 0x5000);
+	}
+	if (fMdp == 0) {
+		return false;
+	}
+	uint32_t ver = mdp_rd(fMdp, qs), src = mdp_rd(fMdp, vig + 0x00), out = mdp_rd(fMdp, vig + 0x0c);
+	if (ver != 0x1002 || src != (dw | dh << 16) || out != (dw | dh << 16)) {
+		IOLog("SWEET FB: VIG0 not as expected (qseed 0x%x src 0x%x out 0x%x): CPU scaling\n", ver, src, out);
+		return false;
+	}
+	/* black logical area first: it is shown stretched from the next frame on */
+	for (uint32_t y = 0; y < sh; y++) {
+		bzero((void *)(fPixels + (uint64_t)y * fRowBytes), (size_t)sw * 4);
+	}
+	mdp_wr(fMdp, qs + 0x0c, 0);                                             /* PHASE_INIT */
+	mdp_wr(fMdp, qs + 0x10, (uint32_t)(((uint64_t)sw << 21) / dw));         /* PHASE_STEP_Y_H */
+	mdp_wr(fMdp, qs + 0x14, (uint32_t)(((uint64_t)sh << 21) / dh));         /* PHASE_STEP_Y_V */
+	mdp_wr(fMdp, qs + 0x18, (uint32_t)(((uint64_t)sw << 21) / dw));
+	mdp_wr(fMdp, qs + 0x1c, (uint32_t)(((uint64_t)sh << 21) / dh));
+	mdp_wr(fMdp, qs + 0x20, 4u | 3u << 8 | 4u << 16 | 3u << 24);            /* PRELOAD */
+	mdp_wr(fMdp, qs + 0x40, sw | sh << 16);                                 /* SRC_SIZE_Y_RGB_A */
+	mdp_wr(fMdp, qs + 0x44, sw | sh << 16);                                 /* SRC_SIZE_UV */
+	mdp_wr(fMdp, qs + 0x48, dw | dh << 16);                                 /* DST_SIZE */
+	mdp_wr(fMdp, qs + 0x04, 1u | 3u << 16 | 1u << 14 | 1u << 10 | 1u << 30); /* OP_MODE */
+	mdp_wr(fMdp, vig + 0x00, sw | sh << 16);                                /* fetch the logical size */
+	mdp_wr(fMdp, 0x1018, 1);                                                /* CTL0 FLUSH: VIG0 */
+	IOLog("SWEET FB: VIG0 QSEED3 scales %ux%u -> %ux%u (op 0x%x src 0x%x)\n", sw, sh, dw, dh,
+	    mdp_rd(fMdp, qs + 0x04), mdp_rd(fMdp, vig + 0x00));
+	return true;
+}
