+/*
+ * One layer, logical rect (dx,dy,w,h) <- surface (sx,sy), scaled up to the
+ * panel. Each panel row picks its logical row; a row that repeats the one
+ * above it (1.44x: every other row or so) is a memcpy of the previous one.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL ||
+	    sx < 0 || sy < 0 || dx < 0 || dy < 0) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0 ||
+	    (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4 >
+	    s->memory->getLength()) {
+		return;
+	}
+	/* panel columns/rows covered by the logical rect */
+	uint32_t px0 = (uint32_t)(((uint64_t)dx * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t py0 = (uint32_t)(((uint64_t)dy * fHeight + fLogicalH - 1) / fLogicalH);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * fHeight + fLogicalH - 1) / fLogicalH);
+	px1 = px1 > fWidth ? fWidth : px1;
+	py1 = py1 > fHeight ? fHeight : py1;
+	const uint8_t *base = (const uint8_t *)(src + s->offset);
+	int32_t prev = -1;
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)((uint64_t)py * fLogicalH / fHeight);
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		if (ly == prev) {
+			memcpy(out + px0, (const uint32_t *)(fPixels + (uint64_t)(py - 1) * fRowBytes) + px0,
+			    (size_t)(px1 - px0) * 4);
+			continue;
+		}
+		prev = ly;
+		const uint32_t *in = (const uint32_t *)(base + (uint64_t)(sy + ly - dy) * s->bytesPerRow) + sx - dx;
+		for (uint32_t px = px0; px < px1; px++) {
+			out[px] = in[fXMap[px]];
+		}
+	}
+}
